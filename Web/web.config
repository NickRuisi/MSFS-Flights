<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the ASP.NET Core Module (ANCM V2), installed by the .NET Hosting Bundle.

  `dotnet publish` copies this file to the output and fixes up processPath/arguments for you
  (for example, it switches them to the .exe for a self-contained publish).
  `dotnet run` ignores this file.

  This file can't stop idle shutdowns or recycling. Those are app pool settings
  (idle timeout, start mode, periodic restart, preload). deploy\Install-IisSite.ps1 sets them.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <!-- Send every request to ASP.NET Core; it serves wwwroot and the API itself. -->
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        hostingModel="inprocess": the app runs inside w3wp.exe and does not use Kestrel.
        startupTimeLimit / shutdownTimeLimit: seconds ANCM waits for the app to start, and to
        drain on recycle, before giving up.
        stdoutLogEnabled: set to "true" only to diagnose startup failures (HTTP 500.30).
        The logs folder must exist and be writable by the app pool identity.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\MsfsTelemetry.Web.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  startupTimeLimit="120"
                  shutdownTimeLimit="30">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
