{
  "ConnectionStrings": {
    // A relative Data Source is resolved against the content root (the app folder), so the
    // file lands in the same place under `dotnet run` and under IIS (whose working directory
    // is not the site folder). Note: Microsoft.Data.Sqlite does NOT accept a "Journal Mode"
    // keyword; WAL is set with a PRAGMA from the "Database" section below.
    "Airports": "Data Source=App_Data/airports.db;Mode=ReadWriteCreate;Pooling=True;Default Timeout=30"
  },
  "Database": {
    // Applied once at startup. WAL is persistent: it is stored in the database file itself.
    "JournalMode": "WAL",
    // Applied to every connection when it opens. NORMAL is safe with WAL and much faster than FULL.
    "Synchronous": "NORMAL"
  },
  "Authentication": {
    "Google": {
      // OAuth 2.0 *Web application* client ID from Google Cloud Console → APIs & Services → Credentials.
      // Not a secret: the browser needs it to show the sign-in button. Leave empty to turn sign-in off.
      // Add every origin the site is served from (e.g. http://localhost:5000 and http://localhost)
      // under "Authorized JavaScript origins". No redirect URI or client secret is needed.
      "ClientId": "1063671454704-r60mipcpu7tgde38r5l237ou74h4qof8.apps.googleusercontent.com",
      // Optional: only allow accounts from one Google Workspace domain, e.g. "example.com".
      "HostedDomain": null,
      "RequireVerifiedEmail": true
    }
  },
  "Cors": {
    // The bundled frontend is served from the same origin and needs no CORS.
    // List other origins here only if a separate frontend calls the API, e.g. "http://localhost:5173".
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*"
}
