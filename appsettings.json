{
  "Telemetry": {
    "PollInterval": "00:00:05",
    "ReconnectDelay": "00:00:10",
    "OnlyRecordWhileInFlight": true,
    "ExitWhenSimulatorQuits": false,
    "LogSamples": false,
    "AutoStart": true,
    "AutoStartSpeedKnots": 5
  },
  "Storage": {
    "DatabasePath": "%LOCALAPPDATA%\\MsfsTelemetry\\telemetry.db"
  },
  "Upload": {
    "BaseUrl": "http://localhost:5000/",
    "Automatic": false,
    "RetryInterval": "00:05:00",
    "RequestTimeout": "00:00:30"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  }
}
